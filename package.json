{
  "name": "near-petri",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "pnpm test:contract && pnpm test:js",
    "test:contract": "cargo test",
