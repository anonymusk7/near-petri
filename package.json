{
  "name": "near-petri",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "pnpm test:contract && pnpm test:js",
    "test:contract": "cargo test",
    "test:js": "node --test test/*.test.mjs",
    "build:contract": "cargo build -p petri --target wasm32-unknown-unknown --release",
    "chat:mock": "node scripts/chat-mock.mjs",
    "verify": "node scripts/verify.mjs",
    "preflight": "MOCK_AI=0 node scripts/preflight.mjs",
    "record:tee": "MOCK_AI=0 node scripts/record-tee.mjs",
    "demo:testnet": "node scripts/demo-testnet.mjs",
    "build:contract:deploy": "RUSTFLAGS=\"-C target-cpu=mvp -C link-arg=-s\" cargo build -p petri --target wasm32-unknown-unknown --release --target-dir target/mvp",
    "demo:v2": "node scripts/demo-v2.mjs",
    "record:arena": "MOCK_AI=0 node scripts/record-arena.mjs",
    "tip:prepare": "node scripts/tip-prepare.mjs",
    "web:install": "pnpm --dir web install --frozen-lockfile",
    "web:build": "pnpm web:install && pnpm --dir web build",
    "web": "pnpm web:build && node web/server.mjs",
    "record:moss": "MOCK_AI=0 node scripts/record-moss.mjs",
    "record:pot": "MOCK_AI=0 node scripts/record-pot.mjs",
    "web:export": "node scripts/export-static.mjs",
    "wallet:live": "node scripts/wallet-live.mjs",
    "web:static": "pnpm web:install && pnpm web:export && VITE_STATIC=1 pnpm --dir web build && node scripts/scan-static.mjs web/dist-static"
  },
  "dependencies": {
    "@phala/dcap-qvl": "0.7.0",
    "ethers": "6.17.0"
  },
  "devDependencies": {
    "@near-js/crypto": "2.5.1",
    "@near-js/transactions": "2.5.1",
    "@near-js/utils": "2.5.1"
  }
}
